{
  "$schema": "https://json.schemastore.org/json",
  "source": {
    "frontend": {
      "semantic_tokens_css": "ProjectCEA/Infrastructure/frontend/src/styles/index.css",
      "themes_css": "ProjectCEA/Infrastructure/frontend/src/styles/themes.css"
    }
  },
  "semantic": {
    "surface": {
      "base": "--color-surface-base",
      "primary": "--color-surface-primary",
      "secondary": "--color-surface-secondary",
      "tertiary": "--color-surface-tertiary",
      "quaternary": "--color-surface-quaternary",
      "quinary": "--color-surface-quinary"
    },
    "text": {
      "default": "--color-text-default",
      "strong": "--color-text-strong",
      "input": "--color-text-input",
      "secondary": "--color-text-secondary",
      "muted": "--color-text-muted",
      "subtle": "--color-text-subtle",
      "faint": "--color-text-faint"
    },
    "accent": {
      "primary": {
        "vivid": "--color-accent-vivid",
        "hover": "--color-accent-hover",
        "active": "--color-accent-active",
        "dim": "--color-accent-dim"
      },
      "data": "--color-accent-data",
      "setpoint": "--color-accent-setpoint",
      "setpointDim": "--color-accent-setpoint-dim"
    },
    "button": {
      "primary": {
        "base": "--color-btn-primary",
        "hover": "--color-btn-primary-hover",
        "light": "--color-btn-primary-light",
        "data": "--color-btn-primary-data",
        "text": "--color-btn-primary-text",
        "dim": "--color-btn-primary-dim",
        "active": "--color-btn-primary-active",
        "info": "--color-btn-primary-info"
      }
    },
    "status": {
      "success": {
        "base": "--color-status-success",
        "vivid": "--color-status-success-vivid",
        "bg": "--color-status-success-bg",
        "text": "--color-status-success-text",
        "border": "--color-status-success-border"
      },
      "danger": {
        "base": "--color-status-danger",
        "vivid": "--color-status-danger-vivid",
        "bg": "--color-status-danger-bg",
        "text": "--color-status-danger-text",
        "border": "--color-status-danger-border"
      },
      "warning": {
        "base": "--color-status-warning",
        "vivid": "--color-status-warning-vivid",
        "bg": "--color-status-warning-bg",
        "text": "--color-status-warning-text",
        "dim": "--color-status-warning-dim"
      }
    },
    "modes": {
      "auto": {
        "base": "--color-mode-auto",
        "dim": "--color-mode-auto-dim",
        "text": "--color-mode-auto-text",
        "border": "--color-mode-auto-border"
      },
      "submode": "--color-mode-submode"
    },
    "border": {
      "default": "--color-border-default",
      "emphasis": "--color-border-emphasis",
      "subtle": "--color-border-subtle",
      "input": "--color-border-input"
    },
    "periods": {
      "day": "--color-period-day",
      "dayBg": "--color-period-day-bg",
      "preday": "--color-period-preday",
      "predayBg": "--color-period-preday-bg"
    },
    "timeline": {
      "night": "--color-timeline-night",
      "day": "--color-timeline-day",
      "pre": "--color-timeline-pre",
      "ramp": "--color-timeline-ramp",
      "now": "--color-timeline-now"
    }
  }
}

