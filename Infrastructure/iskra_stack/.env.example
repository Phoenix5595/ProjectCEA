# ProjectCEA stack on iskraprojectcea.
#
# Copy to .env, fill in the secrets, then `docker compose up -d`.
#
# mothernode owns the production data — PostgreSQL primary, Redis,
# automation/backend services. iskraprojectcea runs ONLY:
#   - a streaming WAL replica of the primary
#   - a local Redis (used by redis_sync to mirror live state)
#   - redis_sync (periodic snapshot from replica DB → Redis)
#   - Grafana (Phase 5b — relocated from iskradocker; the SPA embeds
#     these dashboards)
#
# Phase 5b switched the host port for Grafana from 3000 to 3001 because
# port 3000 on this VM is already taken by another homelab service.

# ---- Database replica (from mothernode) ----
PRIMARY_HOST=
PRIMARY_PORT=5432
REPLICATION_USER=cea_repl
REPLICATION_PASSWORD=
POSTGRES_DB=cea_sensors
# Optional: name a physical replication slot on the primary so the
# primary can throttle WAL recycling if the replica falls behind.
# REPLICATION_SLOT=iskra_recovery
PGDATA_HOST_PATH=/srv/storage1/projectcea_database/data
# Host-side port for the replica. Container always listens on 5432.
POSTGRES_PORT=5432
# Quebec local timezone used by the replica DB session and Grafana displays.
POSTGRES_TIMEZONE=America/Toronto

# ---- Grafana (projectcea_grafana) ----
# Strong random; openssl rand -hex 16 is fine. Used as the admin
# password for the local Grafana instance.
GRAFANA_ADMIN_PASSWORD=
# Gmail app password for the SMTP relay used by unified-alerting
# (the contact point + rules live in Grafana's SQLite DB; see
# Infrastructure/frontend/grafana/pi-decommission-backup-* for the
# JSON exports re-imported via /api/v1/provisioning). Get a 16-char
# app password at https://myaccount.google.com/apppasswords; paste
# WITHOUT spaces. The legacy Pi grafana-server held this in its
# /etc/grafana/grafana.ini under [smtp] — migrated 2026-04-19.
GRAFANA_SMTP_PASSWORD=

# ---- Redis sync + Grafana CEA datasource ----
# MUST match the cea_user password on mothernode's primary (the
# replica's pg_authid is byte-for-byte identical via WAL replication).
# The replica's pg_hba.conf must include a `host all all
# 172.18.0.0/16 scram-sha-256` rule so containers on the
# projectcea_network can authenticate.
POSTGRES_CEA_USER_PASSWORD=

# ---- Optional ----
# REDIS_PASSWORD=
