# ProjectCEA stack on iskra. Copy to .env and set values.
# Mothernode runs PostgreSQL, Grafana, Redis natively; no Docker on mothernode.

# ---- Database replica (from mothernode) ----
PRIMARY_HOST=
PRIMARY_PORT=5432
REPLICATION_USER=cea_repl
REPLICATION_PASSWORD=
POSTGRES_DB=cea_sensors
# REPLICATION_SLOT=iskra_1
PGDATA_HOST_PATH=/srv/storage1/projectcea_database/data
POSTGRES_PORT=5433

# ---- Grafana ----
GF_SECURITY_ADMIN_PASSWORD=
GF_SERVER_ROOT_URL=http://localhost:3000
GRAFANA_PORT=3000

# ---- Redis sync (reads from replica DB, writes to Redis) ----
# Same as cea_user password on mothernode (replica has same users)
POSTGRES_CEA_USER_PASSWORD=

# ---- Optional ----
# REDIS_PASSWORD=
# GF_DATASOURCE_CEA_PASSWORD=  # if different from POSTGRES_CEA_USER_PASSWORD
