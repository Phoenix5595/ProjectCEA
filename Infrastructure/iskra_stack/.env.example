# ProjectCEA stack on iskraprojectcea.
#
# Copy to .env, fill in the secrets, then `docker compose up -d`.
#
# mothernode owns the production data — PostgreSQL primary, Redis,
# automation/backend services. iskraprojectcea runs ONLY:
#   - a streaming WAL replica of the primary
#   - a local Redis (used by redis_sync to mirror live state)
#   - redis_sync (periodic snapshot from replica DB → Redis)

# ---- Database replica (from mothernode) ----
PRIMARY_HOST=
PRIMARY_PORT=5432
REPLICATION_USER=cea_repl
REPLICATION_PASSWORD=
POSTGRES_DB=cea_sensors
# REQUIRED. Name of the physical replication slot on the primary that
# this standby consumes. Without this set, the primary can recycle WAL
# the standby still needs and replication cannot resume (see
# Infrastructure/REQUIREMENTS.md / iskra_stack README "Recovery"). The
# entrypoint refuses to start if this is empty. The slot must exist on
# the primary first: SELECT pg_create_physical_replication_slot('iskra_recovery');
REPLICATION_SLOT=iskra_recovery
PGDATA_HOST_PATH=/srv/storage1/projectcea_database/data
# Host-side port for the replica. Container always listens on 5432.
POSTGRES_PORT=5432
# Quebec local timezone used by replica DB sessions.
POSTGRES_TIMEZONE=America/Toronto

# ---- Redis sync ----
# MUST match the cea_user password on mothernode's primary (the
# replica's pg_authid is byte-for-byte identical via WAL replication).
# The replica's pg_hba.conf must include a `host all all
# 172.18.0.0/16 scram-sha-256` rule so containers on the
# projectcea_network can authenticate.
POSTGRES_CEA_USER_PASSWORD=

# ---- Optional ----
# REDIS_PASSWORD=
