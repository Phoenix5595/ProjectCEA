# Generated at container start from this template via envsubst (password from env).
# Do not commit datasources.yaml; only this template is in repo.
apiVersion: 1

datasources:
  - name: CEA Sensors
    type: postgres
    uid: bf6vebq5ipybke
    url: projectcea_database:5432
    database: cea_sensors
    user: cea_user
    secureJsonData:
      password: ${POSTGRES_CEA_USER_PASSWORD}
    jsonData:
      # Grafana 12+ SQL datasource reads default DB from jsonData; keep in sync
      # with top-level `database` so pools always open cea_sensors.
      database: cea_sensors
      sslmode: disable
      postgresVersion: 1500
      timescaledb: true
      # See Infrastructure/REQUIREMENTS.md: pool sizing vs 1s refresh fan-out on
      # the replica (POSTGRES_MAX_CONNECTIONS=150). Raised from 32 → 48 after overlay
      # merge; adjust with monitoring if replica CPU or conn wait rises.
      maxOpenConns: 48
      maxIdleConns: 12
      # Aggressive recycle: idle TCP or replica restart leaves dead conns in the
      # pool → intermittent "driver: bad connection" on /api/ds/query until Grafana
      # restarts. After DB maintenance, restart projectcea_grafana as well.
      connMaxLifetime: 90
    isDefault: true
    editable: false

  - name: CEA PostgreSQL
    type: postgres
    uid: cea_postgres
    url: projectcea_database:5432
    database: cea_sensors
    user: cea_user
    secureJsonData:
      password: ${POSTGRES_CEA_USER_PASSWORD}
    jsonData:
      database: cea_sensors
      sslmode: disable
      postgresVersion: 1500
      timescaledb: true
      maxOpenConns: 48
      maxIdleConns: 12
      connMaxLifetime: 90
    editable: false

  - name: Redis
    type: redis-datasource
    uid: bf9yw6nuqt81sa
    url: projectcea_redis:6379
    editable: false

  # Read-only connection to the Pi primary for ops alerts (replication slot /
  # WAL). Host/port come from Grafana container env (PRIMARY_HOST, PRIMARY_PORT).
  # Mothernode pg_hba must allow cea_user from iskra Tailscale IP.
  - name: CEA Primary (ops)
    type: postgres
    uid: cea_primary_ops
    url: ${PRIMARY_HOST}:${PRIMARY_PORT}
    database: cea_sensors
    user: cea_user
    secureJsonData:
      password: ${POSTGRES_CEA_USER_PASSWORD}
    jsonData:
      database: cea_sensors
      sslmode: disable
      postgresVersion: 1500
      timescaledb: true
      maxOpenConns: 4
      maxIdleConns: 2
      connMaxLifetime: 90
    isDefault: false
    editable: false
