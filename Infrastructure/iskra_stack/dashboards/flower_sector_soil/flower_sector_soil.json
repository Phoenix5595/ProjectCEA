          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT time_bucket('1 minute', time) AS time, CASE WHEN mode = 'DAY' THEN 100 ELSE 0 END AS \"DAY Period Overlay\" FROM effective_setpoints WHERE location = 'Flower Room' AND cluster = 'main' AND time >= $__timeFrom() AND time <= $__timeTo() ORDER BY 1",
