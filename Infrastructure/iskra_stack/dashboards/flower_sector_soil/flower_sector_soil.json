          "rawSql": "SELECT time_bucket('1 minute', m.time) AS time, CASE WHEN s.name LIKE '%front_bed%' THEN 'Front Bed' WHEN s.name LIKE '%back_bed%' THEN 'Back Bed' END AS metric, AVG(m.value) AS value FROM measurement m JOIN sensor s ON m.sensor_id = s.sensor_id WHERE s.name LIKE '%soil%temperature%' AND m.time >= $__timeFrom() AND m.time <= $__timeTo() GROUP BY 1, 2 ORDER BY 1",
          "refId": "Temp"
        }
