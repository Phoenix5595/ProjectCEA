      "targets": [
        {
          "datasource": { "type": "postgresql", "uid": "cea_postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (s.sensor_id) s.sensor_id, s.name, m.value, m.time FROM measurement m JOIN sensor s ON m.sensor_id = s.sensor_id WHERE s.name LIKE 'soil_sensor_%' AND m.time >= NOW() - INTERVAL '1 hour' ORDER BY s.sensor_id, m.time DESC) SELECT CASE WHEN name LIKE '%front_bed%' THEN 'Front Bed' WHEN name LIKE '%back_bed%' THEN 'Back Bed' ELSE REPLACE(REPLACE(name, 'soil_sensor_', ''), '_', ' ') END AS \"Location\", MAX(CASE WHEN name LIKE '%_ph' THEN value END) AS \"pH\", MAX(CASE WHEN name LIKE '%_ec' THEN value END) AS \"EC (µS/cm)\", MAX(CASE WHEN name LIKE '%_humidity' THEN value END) AS \"VWC (%)\", MAX(CASE WHEN name LIKE '%_temperature' THEN value END) AS \"Temp (°C)\", MAX(time) AS \"Updated\" FROM latest GROUP BY CASE WHEN name LIKE '%front_bed%' THEN 'Front Bed' WHEN name LIKE '%back_bed%' THEN 'Back Bed' ELSE REPLACE(REPLACE(name, 'soil_sensor_', ''), '_', ' ') END ORDER BY \"Location\"",
          "refId": "A"
        }
      ],
      "title": "Soil Sensors - Current Values",
      "type": "table"
    },
