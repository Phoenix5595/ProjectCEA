[Unit]
Description=CEA Automation Service
After=redis-server.service postgresql.service cea-backend.service network-online.target
Requires=redis-server.service postgresql.service
Wants=cea-backend.service network-online.target
OnFailure=service-error-handler@%n.service

[Service]
Type=simple
# Root required for GPIO / I2C / raw RS485 access via the automation service's
# hardware drivers. PrivateTmp/ProtectSystem/ProtectHome deliberately left off
# so that the hardware sysfs/devfs paths stay visible and writable.
User=root
Group=root
WorkingDirectory=/opt/projectcea/current/Infrastructure/automation-service
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/opt/projectcea/current/Infrastructure:/opt/projectcea/current/Infrastructure/automation-service
Environment=REDIS_URL=redis://localhost:6379
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_DB=cea_sensors
Environment=POSTGRES_USER=cea_user
# POSTGRES_PASSWORD is loaded from /opt/projectcea/shared/env/postgres.env
# (owner root, mode 0640). Populated by Infrastructure/setup_timescaledb.sh
# during initial Pi bootstrap and by the Phase 1.1b password rotation procedure
# documented in Infrastructure/REQUIREMENTS.md. `-` prefix = optional, so the
# unit still starts even if the env file is absent (useful for first-boot
# bootstrap before the file is materialised).
EnvironmentFile=-/opt/projectcea/shared/env/postgres.env
EnvironmentFile=-/opt/projectcea/shared/env/api_key.env
ExecStart=/opt/projectcea/current/Infrastructure/automation-service/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- Phase 3.8: pass the Postgres password via systemd credentials.
# `LoadCredential=` copies the source file into a per-unit credential
# directory (owned by root, mode 0400) and exports CREDENTIALS_DIRECTORY.
# The app reads $CREDENTIALS_DIRECTORY/postgres_password via
# shared.db_credentials.load_postgres_password(). The env var path
# (POSTGRES_PASSWORD via EnvironmentFile above) is retained as a
# fallback so a broken credential file cannot brick the service.
LoadCredential=postgres_password:/opt/projectcea/shared/env/postgres_password

# --- Phase 3.7 exploit containment (additive).
# Services still run as root for direct hardware access (GPIO / I2C / 1-Wire /
# RS485 / CAN). The directives below narrow the kernel attack surface reachable
# from them without touching hardware paths: no modprobe, no RT scheduling, no
# setuid exec, no /proc/sys mutation anywhere in the control / sensor code.
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
