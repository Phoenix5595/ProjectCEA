{
  "name": "cea-frontend",
  "version": "1.2.6",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "release:major": "npm version major --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:patch": "npm version patch --no-git-tag-version",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\" \"tests/**/*.{ts,tsx}\" eslint.config.mjs vite.monitoring.config.ts playwright.monitoring.config.ts playwright.event-log.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"tests/**/*.{ts,tsx}\" eslint.config.mjs vite.monitoring.config.ts playwright.monitoring.config.ts playwright.event-log.config.ts",
    "api:generate": "python3 ../automation-service/scripts/export_openapi.py src/generated/openapi.json && openapi-typescript src/generated/openapi.json -o src/generated/api.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/generated",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@daypicker/react": "10.0.1",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "4.3.3",
    "axios": "1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sonner": "2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uplot": "1.6.32",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint-react/eslint-plugin": "^5.21.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.1",
    "@typescript-eslint/parser": "8.70.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "^5.2.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
