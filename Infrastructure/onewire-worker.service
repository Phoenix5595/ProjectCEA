[Unit]
Description=CEA 1-Wire Worker (DS18B20 lab/water temp)
After=redis-server.service network-online.target
Requires=redis-server.service
Wants=network-online.target
OnFailure=service-error-handler@%n.service

[Service]
Type=simple
# Root for /sys/bus/w1 access on Raspberry Pi.
User=root
Group=root
WorkingDirectory=/opt/projectcea/current/Infrastructure/onewire-worker-service
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/opt/projectcea/current/Infrastructure
Environment=REDIS_URL=redis://localhost:6379
# 1-Wire worker has no DB today, but the env file is harmless if loaded.
EnvironmentFile=-/opt/projectcea/shared/env/postgres.env
ExecStart=/opt/projectcea/current/Infrastructure/onewire-worker-service/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8004
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- Phase 3.8: pass the Postgres password via systemd credentials.
# `LoadCredential=` copies the source file into a per-unit credential
# directory (owned by root, mode 0400) and exports CREDENTIALS_DIRECTORY.
# The app reads $CREDENTIALS_DIRECTORY/postgres_password via
# shared.db_credentials.load_postgres_password(). The env var path
# (POSTGRES_PASSWORD via EnvironmentFile above) is retained as a
# fallback so a broken credential file cannot brick the service.
LoadCredential=postgres_password:/opt/projectcea/shared/env/postgres_password

# --- Phase 3.7 exploit containment (additive).
# Services still run as root for direct hardware access (GPIO / I2C / 1-Wire /
# RS485 / CAN). The directives below narrow the kernel attack surface reachable
# from them without touching hardware paths: no modprobe, no RT scheduling, no
# setuid exec, no /proc/sys mutation anywhere in the control / sensor code.
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
