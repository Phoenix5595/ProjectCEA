[Unit]
Description=CEA 1-Wire Worker (DS18B20 lab/water temp)
After=redis-server.service network-online.target
Requires=redis-server.service
Wants=network-online.target
OnFailure=service-error-handler@%n.service

[Service]
Type=simple
# Root for /sys/bus/w1 access on Raspberry Pi.
User=root
Group=root
WorkingDirectory=/opt/projectcea/current/Infrastructure/onewire-worker-service
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/opt/projectcea/current/Infrastructure
Environment=REDIS_URL=redis://localhost:6379
# 1-Wire worker has no DB today, but the env file is harmless if loaded.
EnvironmentFile=-/opt/projectcea/shared/env/postgres.env
ExecStart=/opt/projectcea/current/Infrastructure/onewire-worker-service/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8004
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
