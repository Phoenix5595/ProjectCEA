# ProjectCEA TimescaleDB replica (iskra only). Copy to .env and set values.
# Mothernode runs PostgreSQL natively; no Docker on mothernode.

# Primary (mothernode) – LAN or Tailscale hostname/IP
PRIMARY_HOST=
PRIMARY_PORT=5432

# Replication user (create on mothernode; see README)
REPLICATION_USER=cea_repl
REPLICATION_PASSWORD=

# Database name (must match mothernode)
POSTGRES_DB=cea_sensors

# Optional: replication slot on primary (recommended for Tailscale)
# REPLICATION_SLOT=iskra_1

# PGDATA on iskra: path on Storage 1 (check "Before implementing" in README)
PGDATA_HOST_PATH=/mnt/storage1/projectcea_database/data

# Host port for Grafana (use 5433 if 5432 already in use on iskra)
POSTGRES_PORT=5432
