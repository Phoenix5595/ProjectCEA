[Unit]
Description=CEA Weather Service
After=redis-server.service postgresql.service network-online.target
Requires=redis-server.service postgresql.service
Wants=network-online.target
OnFailure=service-error-handler@%n.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/projectcea/current/Infrastructure/weather-service
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/opt/projectcea/current/Infrastructure:/opt/projectcea/current/Infrastructure/automation-service
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_DB=cea_sensors
Environment=POSTGRES_USER=cea_user
EnvironmentFile=-/opt/projectcea/shared/env/postgres.env
ExecStart=/opt/projectcea/current/Infrastructure/weather-service/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8003
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
