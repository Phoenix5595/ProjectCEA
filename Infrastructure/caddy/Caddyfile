# ProjectCEA reverse proxy (Phase 3.4 complete).
#
# Purpose: single LAN/Tailscale entrypoint for the SPA + all microservices.
# FastAPI services bind to 127.0.0.1; Caddy listens on :8080 and forwards to
# loopback backends. API-key enforcement is handled by the shared FastAPI
# middleware and the SPA sends X-API-Key from the production bundle.
#
# NOTE: Caddy automatically preserves WebSocket upgrades in `reverse_proxy`.
{
	# No admin API exposure, no auto-HTTPS (we're intentionally HTTP on :8080).
	admin off
	auto_https off
	log default {
		output file /var/log/caddy/caddy.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
		level INFO
	}
}

:8080 {
	encode gzip

	# ------------------------------------------------------------------
	# Per-site access log. Keeps HTTP traffic records separate from the
	# global caddy.log (internal/diagnostic messages) and gives them a
	# higher retention (20 MB × 5 files). Added live 2026-04-18 — pulled
	# back into the repo 2026-04-21 during Phase 5c/6 cleanup drift audit.
	# ------------------------------------------------------------------
	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
		format json
		level INFO
	}

	# ------------------------------------------------------------------
	# Cache policy (prevents stale SPA-bundle bugs after redeploy).
	#   /assets/*   → content-hashed, safe to cache forever (immutable).
	#   everything else (incl. index.html / SPA routes) → must revalidate,
	#   so browsers always pick up a freshly-deployed index.html that
	#   points at the newest hashed chunks.
	# ------------------------------------------------------------------
	@hashed_assets path /assets/*
	header @hashed_assets Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache, must-revalidate"

	# Browser access is limited to documented GET-only monitoring reads. The
	# decoded path regex forbids slash and percent in each room/node segment.
	@monitoring_sensor_read {
		method GET
		path_regexp monitoring_sensor_read ^/api/sensors/monitoring/(?:range|stats)/[^/%]+$|^/api/sensors/monitoring/live/[^/%]+/[^/%]+$
	}
	handle @monitoring_sensor_read {
		request_header -X-API-Key
		reverse_proxy 127.0.0.1:8005 {
			header_up X-API-Key {env.CEA_API_KEY}
		}
	}

	@monitoring_control_read {
		method GET
		path_regexp monitoring_control_read ^/api/monitoring/control/[^/%]+/(?:history|current|projection)$
	}
	handle @monitoring_control_read {
		request_header -X-API-Key
		reverse_proxy 127.0.0.1:8005 {
			header_up X-API-Key {env.CEA_API_KEY}
		}
	}

	# ------------------------------------------------------------------
	# Backend (sensor data) - port 8000
	# ------------------------------------------------------------------
	@backend_api path /api/sensors /api/sensors/* /api/sensor-data /api/sensor-data/*
	handle @backend_api {
		reverse_proxy 127.0.0.1:8000
	}

	# Backend WebSocket is `/ws/<location>` (one or more path segments).
	@backend_ws path /ws/*
	handle @backend_ws {
		reverse_proxy 127.0.0.1:8000
	}

	# ------------------------------------------------------------------
	# Weather service - port 8003
	# ------------------------------------------------------------------
	@weather path /weather /weather/*
	handle @weather {
		reverse_proxy 127.0.0.1:8003
	}

	# ------------------------------------------------------------------
	# Grafana (Phase 5c): the SPA embeds projectcea_grafana directly
	# at http://iskraprojectcea:3001 (via VITE_GRAFANA_BASE_URL). The
	# Pi-local grafana-server was decommissioned 2026-04-19; no local
	# /grafana/* proxy is needed here anymore.
	# ------------------------------------------------------------------

	# ------------------------------------------------------------------
	# Soil / onewire services - not consumed by the SPA today but exposed
	# under explicit prefixes for future expansion & operator tooling.
	# (Keeps the top-level path space clean for the automation SPA.)
	# ------------------------------------------------------------------
	handle_path /svc/soil/* {
		reverse_proxy 127.0.0.1:8002
	}
	handle_path /svc/onewire/* {
		reverse_proxy 127.0.0.1:8004
	}

	# ------------------------------------------------------------------
	# Automation service WebSocket (exact /ws, no trailing segment).
	# ------------------------------------------------------------------
	@auto_ws path /ws
	handle @auto_ws {
		reverse_proxy 127.0.0.1:8001
	}

	# ------------------------------------------------------------------
	# Fallback: automation service (API + SPA static assets at /).
	# ------------------------------------------------------------------
	handle {
		reverse_proxy 127.0.0.1:8001
	}
}
