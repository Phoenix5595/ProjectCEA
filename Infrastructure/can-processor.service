[Unit]
Description=CEA CAN Processor - CAN bus to Redis/TimescaleDB
After=can-setup.service redis-server.service postgresql.service network-online.target
Requires=can-setup.service redis-server.service postgresql.service
Wants=network-online.target
OnFailure=service-error-handler@%n.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/projectcea/current/Infrastructure/can-processor-service
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/opt/projectcea/current/Infrastructure:/opt/projectcea/current/Infrastructure/automation-service
Environment=REDIS_URL=redis://localhost:6379
Environment=POSTGRES_HOST=localhost
Environment=POSTGRES_DB=cea_sensors
Environment=POSTGRES_USER=cea_user
EnvironmentFile=-/opt/projectcea/shared/env/postgres.env
# NOTE: do NOT add PrivateTmp, ProtectHome, or ProtectSystem=strict here; on
# some kernels/filesystems where /var/tmp is a symlink to /tmp this causes
# exit code 226/NAMESPACE and the CAN processor won't start.
ExecStart=/opt/projectcea/current/Infrastructure/can-processor-service/.venv/bin/python -m app.main --verbose
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- Phase 3.7 exploit containment (additive).
# Services still run as root for direct hardware access (GPIO / I2C / 1-Wire /
# RS485 / CAN). The directives below narrow the kernel attack surface reachable
# from them without touching hardware paths: no modprobe, no RT scheduling, no
# setuid exec, no /proc/sys mutation anywhere in the control / sensor code.
NoNewPrivileges=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
